# ============================================
# Navratri 2026 App - Environment Configuration
# ============================================

# Server Configuration
APP_PORT=9000
APP_HOST=localhost

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=navratri_2026
PG_USER=postgres
PG_PASSWORD=your_password_here

# Use PostgreSQL (true) or SQLite (false)
USE_POSTGRESQL=false

# Flutter Configuration
FLUTTER_WEB_PORT=9000
FLUTTER_WEB_HOSTNAME=localhost

# App Configuration
APP_NAME=Navratri 2026 - Nishitpark
APP_VERSION=1.0.0

# Feature Flags
ENABLE_QR_SCAN=true
ENABLE_WHATSAPP_SHARE=true
ENABLE_COUNTDOWN=true
